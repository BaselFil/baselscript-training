SQL_LIST_COLUMNS;Prefix;None;ApplicationDatabase;SQL_LIST_COLUMNS table(<t>) OUTPUT(<x>)
SQL_INSERT;Prefix;None;ApplicationDatabase;SQL_INSERT INTO <t>(<f>) VALUES(<v>)
