SQL_SELECT_COUNT;Prefix;None;ApplicationDatabase;SQL_SELECT_COUNT TABLE(<t>) [WHERE(...)] OUTPUT(<x>)
SQL_SELECT_AVG;Prefix;None;ApplicationDatabase;SQL_SELECT_AVG <f> FROM <t> [WHERE(...)] OUTPUT(<x>)
SQL_SELECT;Prefix;None;ApplicationDatabase;SQL_SELECT <f> FROM <t> [WHERE(...)] [OUTPUT(<x>)]
SQL_EXIST;Prefix;None;ApplicationDatabase;SQL_EXIST <t> OUTPUT(<x>)
