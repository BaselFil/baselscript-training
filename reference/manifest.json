{
  "schema": "baselscript-reference-manifest-v3",
  "reference_version": "universal-v1-2026-09-02",
  "compatibility": {
    "previous_schema": "baselscript-reference-manifest-v2",
    "path_arrays_preserved": true,
    "rule": "Existing path-based consumers may continue to use all original path arrays unchanged. Consumers that require direct URLs must resolve each path through raw_urls."
  },
  "repository": {
    "owner": "BaselFil",
    "name": "baselscript-training",
    "branch": "main",
    "path_base": "repository_root",
    "raw_base_url": "https://raw.githubusercontent.com/BaselFil/baselscript-training/main/"
  },
  "entrypoints": [
    "reference/manifest.json",
    "reference/AI_CONTEXT.md"
  ],
  "deepseek_policy": {
    "requires_direct_urls": true,
    "manifest_url": "https://raw.githubusercontent.com/BaselFil/baselscript-training/main/reference/manifest.json",
    "context_url": "https://raw.githubusercontent.com/BaselFil/baselscript-training/main/reference/AI_CONTEXT.md",
    "resolution_rule": "For every path selected from baseline_required, task_routes, machine_contract or another manifest field, read the exact matching URL from raw_urls. Do not substitute a normal github.com page URL.",
    "load_order": [
      "entrypoints",
      "baseline_required",
      "applicable task_routes",
      "applicable route_expansion_rules",
      "machine contract only as routed or explicitly required"
    ],
    "do_not_invent_missing_urls": true
  },
  "machine_contract": {
    "directory": "reference/language",
    "files": [
      "reference/language/functions.def",
      "reference/language/actions.def",
      "reference/language/blocks.def",
      "reference/language/conditions.def",
      "reference/language/scene.def",
      "reference/language/baselscript-language.json"
    ],
    "full_json_policy": "Do not load baselscript-language.json by default. Load it only through machine_full/ui_defaults or explicit fallback validation."
  },
  "baseline_required": [
    "reference/AI_CONTEXT.md",
    "reference/knowledge/generation_rules.md",
    "reference/semantics/00_INDEX.md",
    "reference/semantics/01_core_language.md"
  ],
