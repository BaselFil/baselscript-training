    "complete_script": [
      "structure",
      "call_execution"
    ],
    "file_backed_list": [
      "files_data",
      "list"
    ],
    "file_backed_form": [
      "files_data",
      "form"
    ],
    "adaptive_form": [
      "form",
      "platform"
    ],
    "adaptive_list": [
      "list",
      "platform"
    ],
    "file_backed_adaptive_form_and_list": [
      "files_data",
      "form",
      "list",
      "platform",
      "structure",
      "call_execution"
    ],
    "sql_rows_displayed_as_list": [
      "database_sql",
      "files_data",
      "list"
    ],
    "chart_from_file": [
      "charts",
      "files_data"
    ],
    "graphics_from_file": [
      "graphics",
      "files_data"
    ],
    "graphics_from_array": [
      "graphics",
      "arrays_hash"
    ],
    "encrypted_application_database": [
      "database_sql",
      "security_crypto"
    ]
  },
  "evidence_policy": {
    "load_by_default": false,
    "directory": "reference/evidence",
    "rule": "Load evidence/regression only to resolve uncertainty, verify a disputed form, or perform an audit."
  },
  "generation_policy_file": "reference/knowledge/generation_rules.md",
  "source_authority": [
    "confirmed current runtime/regression",
    "current routed machine contract (.def / explicit JSON route)",
    "current routed semantics",
    "current routed composition patterns",
    "repeated real-script evidence",
    "rare/historical evidence"
  ],
