// TEST: R06
// CHECK: real FORM from 06_8_primitive_form.script; BaselScript body unchanged
// EXPECT: OK; portrait or landscape form is drawn

SCENE=1 id="2 forms"  cs=white
-----------------------------------------------
SECTION init
   #form=0
   #style=normal
   #weight=normal
   #trigger=0

   if #trigger==1
        #style=italicbold
    else
        #style=""
    endif


    if #_orientation == portrait
            #form=0
    else
            #form=1
    endif
   draw form=#form
END

// Form layout for portrait orientation
FORM 0

        tile=text id=#titel x=400 y=140  text=@|_address style=#style 
 
       // Text labels for each input field
        tile=property  x=30 w=200 style=#style      
        tile=text  y=240 text=@|_last_name
        tile=text  y=340 text=@|_first_name
        tile=text  y=440 text=@|_city
        tile=text  y=540 text=@|_street


        // Input fields
        tile=property  w=440 x=260  style=#style 
        tile=input id=#name_person      y=240  hint="enter last name here"
        tile=input id=#firstname_person y=340  hint="enter first name here"
        tile=input id=#city_person      y=440  hint="enter city here"
        tile=input id=#street_person    y=540  hint="enter street here"

        // Buttons for navigation and style change
        tile=button text=@_back           y=640 x=260  style=#style  sec=back
        tile=button text="change style"   y=840 x=260  style=#style  sec=ch

END

// Form layout for landscape orientation
FORM 1

        tile=text id=#titel x=400 y=40  text=@|_address style=#style  s=40  
        tile=prop x=30 w=200 sty=#style 

        tile=text  y=140 text=@|_last_name
        tile=text  y=240 text=@|_first_name
        tile=text  y=340 text=@|_city
        tile=text  y=440 text=@|_street

        tile=prop  w=440 x=260  sty=#style 

        tile=input id=#name_person      y=140
        tile=input id=#firstname_person y=240
        tile=input id=#city_person      y=340
        tile=input id=#street_person    y=440

        tile=button id=b text=@_back         y=580 x=260  sty=#style sec=back
        tile=button id=b text="change style" y=580 x=710  sty=#style sec=ch

END

// button "change style" was pressed
SECTION ch

    // Toggle trigger and update style
    #trigger =1-#trigger

    // Toggle style based on trigger
    if #trigger==1
        #style=italicbold
    else
        #style=""
    endif
 
    draw form=#form
END 

// Navigate back to the previous screen
SECTION back
      call scr=examples_form
END 

END SCENE 1


