// TEST: R48C
// REPLACES: R48 (rewritten to use proven SQL_SELECT scalar OUTPUT semantics)
// CHECK: ORDER BY + LIMIT + OFFSET with two scalar output variables
// EXPECT: PASS; final trace R48C OK=1 TOP_AGE=30 TOP_NAME=C SECOND_AGE=20 SECOND_NAME=B

SCENE=1

SECTION init
    #ok=1
    #_database_result="0"

    db_use "REGRESSION_SQL"

    if #_database_result != "1"
        trace $concate("R48C DATABASE ERROR ",#_error)
        return
    endif

    SQL_DROP_TABLE table(reg_order)

    SQL_CREATE_TABLE table(reg_order) \
        fields(id:INTEGER_PRIMARY_KEY,name:TEXT,age:INTEGER)

    SQL_INSERT INTO reg_order(name,age) VALUES('A',10)
    SQL_INSERT INTO reg_order(name,age) VALUES('B',20)
    SQL_INSERT INTO reg_order(name,age) VALUES('C',30)

    SQL_SELECT age,name \
        FROM reg_order \
        ORDER BY age DESC \
        LIMIT 1 \
        OUTPUT(#top_age,#top_name)

    SQL_SELECT age,name \
        FROM reg_order \
        ORDER BY age DESC \
        LIMIT 1 OFFSET 1 \
        OUTPUT(#second_age,#second_name)

    if #top_age != 30 || #top_name != "C"
        #ok=0
    endif

    if #second_age != 20 || #second_name != "B"
        #ok=0
    endif

    trace $concate("R48C OK=",#ok," TOP_AGE=",#top_age," TOP_NAME=",#top_name," SECOND_AGE=",#second_age," SECOND_NAME=",#second_name)

    SQL_DROP_TABLE table(reg_order)
END

END SCENE
