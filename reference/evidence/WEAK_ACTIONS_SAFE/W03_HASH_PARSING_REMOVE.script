// TEST CANDIDATE: W03
// CHECK: parsing hash_array=... and remove hash_array=... key=...
// EXPECT: B=2 before remove, hash length=2 after remove

SCENE=1 title="weak actions - hash parsing"

SECTION init
    #source="a=1 b=2 c=3"

    parsing hash_array=9 string=#source delimiter="="

    #b=$hash.get_value(9,b)
    #len_before=$hash.length(9)

    remove hash_array=9 key=b

    #len_after=$hash.length(9)
    #ok=1

    if #b != "2"
        #ok=0
    endif

    if #len_before != 3
        #ok=0
    endif

    if #len_after != 2
        #ok=0
    endif

    trace $concate("W03 OK=",#ok," B=",#b," LEN_BEFORE=",#len_before," LEN_AFTER=",#len_after)
END

END SCENE
