// TEST CANDIDATE: W01
// CHECK: db_current / db_path / db_exists runtime metadata
// EXPECT: after db_use TEST_WEAK_ACTIONS, alias exists and metadata variables are populated

SCENE=1 title="weak actions - database metadata"

SECTION init
    #ok=1

    db_use "TEST_WEAK_ACTIONS"

    if #_database_result != "1"
        #ok=0
    endif

    db_current
    #current_alias=#_database

    db_path
    #current_path=#_database_path

    db_exists "TEST_WEAK_ACTIONS"

    if #_database_exists != "1"
        #ok=0
    endif

    if #current_alias != "TEST_WEAK_ACTIONS"
        #ok=0
    endif

    trace $concate("W01 OK=",#ok," ALIAS=",#current_alias," PATH=",#current_path," EXISTS=",#_database_exists)
END

END SCENE
