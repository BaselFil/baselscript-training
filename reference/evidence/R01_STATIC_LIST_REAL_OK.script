// TEST: R01
// CHECK: real static LIST from 000_template_list.script; body is unchanged
// EXPECT: OK; list of people is displayed from example_person

SCENE=1 title="List"
   
SECTION init
   file id=example_person record=(#last_name,#first_name,#city,#street,#birthday)
   read file=example_person dir = APPDIR/files/examples
   call list=list1
END

LIST list1
   tile=file id=example_person
   tile=title text="List of people"
   tile=item   id=#first_name
   tile=item   id=#last_name
   tile=item   id=#city
   tile=item   id=#street
   tile=button id=#button_x text =<  act=back
END 

ACTION back
   call scr=000_templates
END 

END SCENE


