// TEST: R15
// CHECK: real indexed ARRAY + FOR loop + $array.sum from 25_3_simple_array.script; body unchanged
// EXPECT: OK; form shows array values and computed sum

// create simple array with dimension 5
---------------------------------------------------------------------------
SCENE=1 title="create simple array" cs=_white

SECTION init
  // array declaration
  array id=#list[5]
 
   // create form
  clear  form=1
  // create title
  create tile=text text="// array declaration" x=50 y=150 sty=italic
  create tile=text text=$concate("array id=#list[5]") x=50 y=200  sty=bold

  // create lines with arrays values
  for #index=0 step=1 to=5 sec=loop

  // compute sum
  #sum= $array.sum(#list)

  // create output line
  create tile=text text=$concate("sum=",#sum) x=50 y=650 sty=italicbold c=blue s=40

  draw form=1
END 

// do it 5 times
-----------------------------------------------------------------------------
SECTION loop
       // set array value
       #list[#index] =#index*2       // 0,2,4,6.8
       // set text
       #text=$concate(#index," element =>  ",#list[#index])        // 0 element => 0 ...
       // create form line
       create tile=text text=#text x=50 y=300+#index*50
END 
--------------------------------------------------------------------------------
SECTION back
     call scr=25_work_with_array
END 
END SCENE 1


