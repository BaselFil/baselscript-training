// TEST: R27
// CHECK: real read script=... to_string=... flow from 14_17_read_file_to_string.script; body unchanged
// EXPECT: OK; _trace.script is read into editor text and form is displayed

SCENE=1 title="read_to_string used in editor"  cs=blue
  
ACTION init

    clear form=1
   
    #scriptname=_trace.script
    #dirname   =APPDIR/script
 
    // read editing file to string
    read script=#scriptname to_string=#_edit dir =#dirname

   

   #h=#_height_virtual-180


   create  tile=text   x= 10 y= 10   w=#_width_virtual text=#scriptname 
   create  tile=input  x= 0  y= 70   id=#_edit w=#_width_virtual h=#h  multiline=1   s=#size  sty=italic bg=transparent
   create  tile=button x= 10 y=#h+70 id=save1 w=250  h=70   text=@back act=back

    draw form=1
END


ACTION back
    call scr=14_000_work_with_files
END 
---------------------------------------------------------
END SCENE


