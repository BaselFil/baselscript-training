// TEST: R13
// CHECK: real _colors.script with long external call script=; body unchanged
// EXPECT: OK; colors list is displayed. BACK calls existing _setting_colorscheme.

SCENE=1 title="show name colors"  cs=bluegray
SECTION init

  file name=_colors record=(#color_num,#color_desc,#color_value) directory= APPDIR/system/schemes
  read file=_colors
  call list=color_list
END
------------------------------------------------------
LIST color_LIST
  tile=file id=_colors
  tile=item   id= #color_desc bg= #color_value text=#cc color= #co sec= xx 
  tile=button id=but text=@_back sec=back
END
-------------------------------------------------------
SECTION xx
       // create color deacription
       #cc= $concate(#color_desc," ",#color_value)
       // get contrast color for background 
       #co=$rgb_contrast(##color_value)
END
-------------------------------------------------------
SECTION back
   call script=_setting_colorscheme
END

END SCENE 1

