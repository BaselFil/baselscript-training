// TEST CANDIDATE: W02
// CHECK: trace_full / trace_as_is / trace_asis / delay dispatch
// EXPECT: trace commands execute in order; delay 1 is a short pause on the Windows checkpoint

SCENE=1 title="weak actions - trace and delay"

SECTION init
    trace_full "W02 TRACE_FULL"
    trace_as_is "W02 TRACE_AS_IS"
    trace_asis "W02 TRACE_ASIS"
    delay 1
    trace "W02 DONE"
END

END SCENE
