// TEST: R11
// CHECK: real directory/file/read/LIST flow with short external call scr=; body unchanged
// EXPECT: OK; script list is displayed. BACK/SELECT can call existing 000_templates.

SCENE=1 title="list of  scripts"

SECTION init
    file id=list record=(#file_name,#file_extention, #file_length,#file_date) dir=APPDIR/files
    #filter=".script"
    directory_list dir=APPDIR/MYDATA/script target_file=list
    read file= list act= filter
    call list=list_f
END

ACTION filter
    #_select_record=0
    if #file_extention == #filter
       #_select_record=1
    endif
END

LIST list_f
    tile=file name =list
    tile=title text="List of scripts in #directory_script"
    tile=item   id=#file_name
    tile=item   id=#file_length
    tile=item   id=#file_date
    tile=button id=#but text=@_back sec=back
    tile=select act=select
END 

ACTION select
    message $concat("selected ",#file_name)
    call scr=000_templates
END 

ACTION back
    call scr=000_templates
END
END SCENE


