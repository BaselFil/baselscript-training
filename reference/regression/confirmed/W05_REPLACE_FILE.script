// TEST CANDIDATE: W05
// CHECK: replace ... file-mode parameter prefixes
// EXPECT: ALPHA becomes OMEGA in output file

SCENE=1

SECTION init
    file id=REG_W05_SOURCE record=(#value) dir=#_directory_files
    file id=REG_W05_TARGET record=(#value) dir=#_directory_files

    if $exist_file(#_directory_files,REG_W05_SOURCE) == 1
        delete file=REG_W05_SOURCE dir=#_directory_files
    endif

    if $exist_file(#_directory_files,REG_W05_TARGET) == 1
        delete file=REG_W05_TARGET dir=#_directory_files
    endif

    #value="ALPHA"
    write_record file=REG_W05_SOURCE dir=#_directory_files

    replace inp_file=REG_W05_SOURCE out_file=REG_W05_TARGET \
        inp_dir=#_directory_files out_dir=#_directory_files \
        inp_string=ALPHA out_string=OMEGA

    read file=REG_W05_TARGET dir=#_directory_files

    #ok=0
    if #value_array[0]=="OMEGA"
        #ok=1
    endif

    trace $concate("W05 OK=",#ok," VALUE=",#value_array[0])

    delete file=REG_W05_SOURCE dir=#_directory_files
    delete file=REG_W05_TARGET dir=#_directory_files
END

END SCENE
