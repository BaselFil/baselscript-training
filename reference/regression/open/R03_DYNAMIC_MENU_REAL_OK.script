// TEST: R03
// CHECK: real runtime MENU from creating_dynamic_menu.script; body is unchanged
// EXPECT: OK; dynamic menu m1 is displayed; menu2 opens m2

SCENE=1 title="dynamic menu" cs=white

SECTION init
    clear menu= m1
    create tile=title text="select option" c=blue sty=italicbold
    create tile=item1 text= "menu2"     c=red      sec=e1
    create tile=item2 text= "option 2"  sty=italic sec=e2
    create tile=item3 text= back        sec=back
    call menu=m1
END

SECTION e1
    clear menu= m2
    create tile=title text= "menu 2" c=blue sty=italic
    create tile=item1 text= "option 111"  sec=e11
    create tile=item2 text= "option 222"  sec=e22
    create tile=item3 text= "call scene2" sce=2
    create tile=item4 text= back          sec=back_to_m1
    call menu=m2
END 

SECTION e2
   message e2
END 

SECTION e11
   message "option 11"
END 

SECTION e22
   message "option 22"
END 

SECTION  back_to_m1
     call sec=init
END 

SECTION  back
     call scr=examples_menu
END 

END SCENE
-------------------
SCENE=2 title=xxx
SECTION init
      message scene2
      call scene=1
END 
END SCENE


