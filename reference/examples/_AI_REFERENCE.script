// _AI_REFERENCE.script
// Purpose:
// Copy the current BaselScript bootstrap prompt for ChatGPT,
// open ChatGPT, or open the public BaselScript AI reference.

// -----------------------------------------------------------------------------
// BaselScript AI Reference
// -----------------------------------------------------------------------------

SCENE=1 title="BaselScript AI Reference"

SECTION init
    #chatgpt_url="https://chatgpt.com/"
    #reference_url="https://github.com/BaselFil/baselscript-training/tree/main/reference"
    #manifest_url="https://raw.githubusercontent.com/BaselFil/baselscript-training/main/reference/manifest.json"
    #context_url="https://raw.githubusercontent.com/BaselFil/baselscript-training/main/reference/AI_CONTEXT.md"

    #prompt=$concat( \
        "Load the current BaselScript reference before answering. Start with: ", \
        #manifest_url," ",#context_url," ", \
        "Then follow the files listed there. ", \
        "Use only documented BaselScript syntax. ", \
        "Do not invent unsupported commands, functions or parameters.")

    draw form=1
END


// -----------------------------------------------------------------------------
// Main form
// -----------------------------------------------------------------------------

FORM 1

    tile=text x=50 y=70 w=700 text="BaselScript AI Reference"

    tile=text x=50 y=145 w=700 \
        text="Use the current GitHub reference when working with ChatGPT."

    tile=button x=50 y=260 w=700 h=80 \
        text="Copy prompt for ChatGPT" section=copy_prompt

    tile=button x=50 y=370 w=700 h=80 \
        text="Open ChatGPT" section=open_chatgpt

    tile=button x=50 y=480 w=700 h=80 \
        text="Open AI Reference" section=open_reference

END


// -----------------------------------------------------------------------------
// Copy the bootstrap prompt
// -----------------------------------------------------------------------------

SECTION copy_prompt
    CLIPBOARD_SET value=#prompt
    message "Prompt copied. Paste it into ChatGPT."
END


// -----------------------------------------------------------------------------
// Open ChatGPT
// -----------------------------------------------------------------------------

SECTION open_chatgpt
    call site=#chatgpt_url
END


// -----------------------------------------------------------------------------
// Open the public BaselScript reference
// -----------------------------------------------------------------------------

SECTION open_reference
    call site=#reference_url
END

END SCENE 1
