// TEST: R47C
// REPLACES: R47 (excluded: wrong SQL_INSERT syntax in test)
// CHECK: CREATE + INSERT + UPDATE + COUNT + SUM + scalar SELECT + DELETE
// EXPECT: PASS; final trace R47C OK=1 C1=3 SUM=65 AGE_A=15 C2=2

SCENE=1

SECTION init
    #ok=1
    #_database_result="0"

    db_use "REGRESSION_SQL"

    if #_database_result != "1"
        trace $concate("R47C DATABASE ERROR ",#_error)
        return
    endif

    SQL_DROP_TABLE table(reg_items)

    SQL_CREATE_TABLE table(reg_items) \
        fields(id:INTEGER_PRIMARY_KEY,name:TEXT,age:INTEGER)

    SQL_INSERT INTO reg_items(name,age) VALUES('A',10)
    SQL_INSERT INTO reg_items(name,age) VALUES('B',20)
    SQL_INSERT INTO reg_items(name,age) VALUES('C',30)

    SQL_UPDATE table(reg_items) \
        FIELDS(age=15) \
        WHERE(name='A')

    SQL_SELECT_COUNT TABLE(reg_items) OUTPUT(#count_before)

    SQL_SELECT_SUM table(reg_items) \
        FIELDS(age) \
        OUTPUT(#sum_age)

    SQL_SELECT age \
        FROM reg_items \
        WHERE name='A' \
        OUTPUT(#age_a)

    SQL_DELETE FROM reg_items WHERE(name='B')

    SQL_SELECT_COUNT TABLE(reg_items) OUTPUT(#count_after)

    if #count_before != 3
        #ok=0
    endif

    if #sum_age != 65
        #ok=0
    endif

    if #age_a != 15
        #ok=0
    endif

    if #count_after != 2
        #ok=0
    endif

    trace $concate("R47C OK=",#ok," C1=",#count_before," SUM=",#sum_age," AGE_A=",#age_a," C2=",#count_after)

    SQL_DROP_TABLE table(reg_items)
END

END SCENE
