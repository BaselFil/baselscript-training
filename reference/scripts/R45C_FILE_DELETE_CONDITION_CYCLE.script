// TEST: R45C
// REPLACES: R45 (excluded: omitted required read-before-delete pattern)
// CHECK: write -> read into memory -> delete record=on_condition -> plain read -> verify survivor
// EXPECT: PASS; R45C OK=1 RECORDS=1 LEN=1 B=1

SCENE=1

SECTION init
    file id=REG_R45 record=(#name,#city) dir=#_directory_files

    if $exist_file(#_directory_files,REG_R45) == 1
        delete file=REG_R45 dir=#_directory_files
    endif

    #name="A"
    #city="Paris"
    write_record file=REG_R45 dir=#_directory_files

    #name="B"
    #city="Mannheim"
    write_record file=REG_R45 dir=#_directory_files

    #name="C"
    #city="Paris"
    write_record file=REG_R45 dir=#_directory_files

    // real conditional-delete pattern loads file records first
    read file=REG_R45 dir=#_directory_files

    delete record=on_condition file=REG_R45 dir=#_directory_files sec=delete_paris

    // independent verification from disk
    read file=REG_R45 dir=#_directory_files

    #ok=1
    #b=0
    #len=$array.length(#name_array)

    if #_records != 1
        #ok=0
    endif

    if #len != 1
        #ok=0
    endif

    if #name_array[0]=="B" && #city_array[0]=="Mannheim"
        #b=1
    endif

    if #b != 1
        #ok=0
    endif

    trace $concate("R45C OK=",#ok," RECORDS=",#_records," LEN=",#len," B=",#b)

    delete file=REG_R45 dir=#_directory_files
END

SECTION delete_paris
    #_delete_record=0

    if #city=="Paris"
        #_delete_record=1
    endif
END

END SCENE
