// TEST: R17
// CHECK: real array/function screen from 17_5_test_function_array.script; body unchanged
// EXPECT: OK; array/hash-array screen opens; function selection flow remains usable

scene=1 title="array functions"
SECTION init
   
   #selected_value=""
   #function=""
   #result=""
   array id=#array[6]
   #array[0]=10
   #array[1]=20
   #array[2]=30
   #array[3]=40
   #array[4]=50
   #array[5]=10

 array id=#array_2[3]
   #array_2[0]=10
   #array_2[1]=20
   #array_2[2]=40
  
   #help= @|_press_select

  clear hash_array=1
  set hash_array=1 key=Germany value=Berlin
  set hash_array=1 key=Italy value=Rome

   if #_orientation == portrait
        #form=port
   else
        #form=land
   endif

   draw form=#form
END 
-------------------------------------------------------
FORM port
   tile=rect  x=20 y=170 w=760 h=320 bg=200
   tile=property g=right   x= 30 w=220 s=32
   tile=text          y= 200  text= " #array[6]="
   tile=text          y= 240  text= " #array_2[3]="
   tile=text          y= 320  text="hash_array =1"

   tile=property  g=left  s=32 x=300 w=460

   tile=text    y= 200    text="10, 20,30,40,50,10"   sty=bold
   tile=text    y= 240    text="10, 20,40"             sty=bold
   tile=text             y= 360    text="key=Germany value=Berlin" sty=bold
   tile=text             y= 400    text="key=Italy value=Rome" sty=bold
 

   tile=property  c=""
   tile=text        x= 10 y=700 w=780  text=$concate(@|_result," ",#result)     sty=bold c=900
   tile=input  id=#input      x= 10 y=770 w=780  text=$as_is(#function)   h=150 multiline=1

   tile=button id=b_select x=10 y=940 w=380  text=@|_select_function  act=select_muster s=26
   tile=text        x=10 y=1040 w=780  text=#help      sty=italic c=black c=900 h=120
END
--
FORM land
   tile=rect  x=20 y=20 w=760 h=290 bg=200
   tile=property g=right   x= 30 w=220 s=32

   tile=text   y= 50   text= " #array[6]="
   tile=text   y= 90  text="#array_2[3]="
   tile=text   y= 170  text="hash_array =1"

   tile=property  g=left  s=32 x=300 w=460 sty=bold
   tile=text     y= 50    text="10, 20,30,40,50,10"

   tile=text    y= 90    text="10, 20,40"
   tile=text             y= 170    text="key=Germany value=Berlin" sty=bold
   tile=text             y= 210    text="key=Italy value=Rome" sty=bold

   tile=property  c= "" sty="" s=""
   tile=text        x= 10 y=400   text=$concate(@|result," ",#result)       sty=bold c=900
   tile=input  id=#input          x= 10 y=460   text=$as_is(#function)   h=110 multiline=1

   tile=button id=#button_select    x= 10 y=570 w=500  text=@|_select_function      act=select_muster  s=35
   tile=text      x=  10 y=680  text=#help    sty=italic  c=900
END
---------------------------------------------------------
ACTION run_function
   if #function==""
        message "function not selected"
       draw form=#form
        return
    endif

    #function=#input
    run from=#input to=#result

    #help=@|_press_select
     draw form=#form
END 
-----------------------------------------------------------
ACTION  select_muster
    file id=example_function_array record=(#function)  dir =APPDIR/files/examples

    read file=example_function_array

    call list=list_function
END 
---------------------------------------------------------
LIST  list_function
    tile=file id=example_function_array
    tile=title text="Select function"
    tile=item id=#function
    tile=button text=@_back   id=button_close_menu   act=back
    tile=select sec=select
END
---------------------------------------------------------
ACTION close
     call scene=1
END 
----------------------------------------------------------
ACTION select
  #result=""
   #select=#function

   run from=#function to=#result

   #selected_value=$remove_double_quotes(#function)
   draw form=#form
END 
---------------------------------------------------------
// if pressed button BACK in bottom then call my menu
ACTION back
       call scr=17_0_test_function
END

END SCENE 1


