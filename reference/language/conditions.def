// BaselScript condition definitions
//
// Format:
// kind;token;role;expression_required
//
// kind:
//   keyword   = condition-control keyword
//   operator  = expression operator metadata
//
// keyword roles:
//   Open
//   ElseIf
//   Else
//   EndIf
//
// expression_required:
//   true  = text after keyword is required
//   false = no expression required
//
// STEP22 note:
// operator rows are metadata only; they do not yet create
// a new blocking expression grammar.

keyword;if;Open;true
keyword;elseif;ElseIf;true
keyword;else;Else;false
keyword;endif;EndIf;false

// STEP23 - operator contract verified against opz.result()
//
// Categories are metadata. They do not change runtime evaluation.
//
// Comparison:
operator;==;Compare;false
operator;!=;Compare;false
operator;>;Compare;false
operator;<;Compare;false
operator;>=;Compare;false
operator;<=;Compare;false

// String containment:
// "contains" is normalized by opz.result() to "><".
// "<>" is the inverse operation.
operator;contains;Contains;false
operator;><;Contains;false
operator;<>;NotContains;false

// Logical:
// Legacy-compatible logical AND spellings:
//   &
//   &&
// Logical OR:
//   ||
operator;&&;LogicalAnd;false
operator;&;LogicalAnd;false
operator;||;LogicalOr;false

// Intentionally NOT listed as valid semantic condition operators:
//   =
//   !
//   |
// They are present in the tokenizer's standart_operators list, but
// opz.result() has no switch implementation for them.
//
// Internal negative-comparison tokenizer forms such as >-, <-, >=-, <=-
// are also intentionally not exposed as language operators.
