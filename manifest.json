  "usage_policy": {
    "purpose": [
      "generate",
      "validate",
      "explain",
      "review",
      "modify"
    ],
    "authoritative_order": [
      "confirmed current runtime/regression evidence",
      "language/*.def",
      "language/baselscript-language.json",
      "knowledge/*.md",
      "repeated real script corpus",
      "rare corpus evidence",
      "historical/review examples"
    ],
    "rules": [
      "Do not invent unsupported BaselScript syntax.",
      "Do not hand-edit language/baselscript-language.json.",
      "If syntax is not confirmed, classify it as unverified.",
      "Before generating BaselScript code, load baseline_required and all matching task_routes.",
      "A task route with hard_gate=true is mandatory; do not answer with domain-specific syntax until its required_files are read.",
      "If several task routes match, load the union of all required_files.",
      "Do not ask the user to restate information that is already present in a required routed file.",
      "When a routed file contains an exact working syntax pattern, prefer that pattern over generic programming knowledge."
    ]
  },
  "raw_base_url": "https://raw.githubusercontent.com/BaselFil/baselscript-training/main/",
  "loading_policy": {
    "mode": "baseline_plus_task_routes",
    "baseline_required": [
      "BASELSCRIPT_AI_CONTEXT.md",
      "language/baselscript-language.json",
      "knowledge/language_status.md",
      "knowledge/generation_rules.md"
    ],
    "before_any_baselscript_code": "Load every baseline_required file, then load every matching task route before answering.",
    "multi_domain_rule": "If a request spans multiple domains, load all matching task routes.",
    "missing_route_file_rule": "If a required routed file cannot be accessed, state which file is unavailable and do not invent domain-specific BaselScript syntax.",
    "no_route_rule": "If no route clearly matches, inspect the relevant current language definition and knowledge file before generating syntax."
  },
